{
  "name": "payhub",
  "version": "1.0.0",
  "description": "PayHub — wallets, double-entry ledger and payments platform",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths && cp -R apps/ledger/proto dist/apps/ledger/proto",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start:api": "node --enable-source-maps dist/apps/api/src/main.js",
    "start:worker": "node --enable-source-maps dist/apps/worker/src/main.js",
    "start:notifications": "node --enable-source-maps dist/apps/notifications/src/main.js",
    "dev:api": "tsx watch --clear-screen=false apps/api/src/main.ts",
    "dev:worker": "tsx watch --clear-screen=false apps/worker/src/main.ts",
    "dev:notifications": "tsx watch --clear-screen=false apps/notifications/src/main.ts",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:revert": "tsx scripts/db.ts revert",
    "db:show": "tsx scripts/db.ts show",
    "db:seed": "tsx scripts/seed.ts",
    "migration:generate": "tsx scripts/db.ts generate",
    "lint": "oxlint --type-aware apps/ libs/ test/",
    "format": "prettier --write \"{apps,libs,test,scripts}/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@bull-board/api": "^9.10.4",
    "@bull-board/express": "^9.10.4",
    "@bull-board/nestjs": "^9.10.4",
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/apollo": "^14.0.3",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.1.3",
    "@nestjs/cqrs": "^12.1.0",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/graphql": "^14.0.3",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/microservices": "^12.1.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/platform-socket.io": "^12.1.3",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "@nestjs/websockets": "^12.1.3",
    "@node-rs/argon2": "^2.2.2",
    "@opentelemetry/auto-instrumentations-node": "^0.81.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prometheus-io/client": "^0.16.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^6.3.15",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dataloader": "^2.2.3",
    "graphql": "^16.14.2",
    "graphql-scalars": "^2.0.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "kafkajs": "^2.2.4",
    "nestjs-cls": "^7.0.1",
    "nestjs-pino": "^5.3.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.4",
    "typeorm": "^1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.18",
    "@testcontainers/kafka": "^12.2.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "testcontainers": "^12.2.1",
    "tsc-alias": "^1.9.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=22"
  }
}
