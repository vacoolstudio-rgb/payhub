# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
SERVICE_NAME=payhub-api
SERVICE_VERSION=1.0.0-dev
PORT=3000
HTTP_GLOBAL_PREFIX=api
SHUTDOWN_GRACE_MS=15000
# How long readiness reports failure before the socket closes, so an
# orchestrator has time to stop routing. Must stay below the grace budget.
SHUTDOWN_DRAIN_DELAY_MS=5000
REQUEST_TIMEOUT_MS=30000
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_LEVEL=debug
LOG_PRETTY=true
METRICS_ENABLED=true
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ---------------------------------------------------------------------------
# Postgres — one instance, one schema per bounded context
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://payhub:payhub@localhost:5432/payhub
DATABASE_SCHEMA=payhub
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_SSL=false
DATABASE_LOGGING=false
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_LOCK_TIMEOUT_MS=5000
# Only the API runs migrations; every other service leaves this false.
DATABASE_RUN_MIGRATIONS=true

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=payhub
REDIS_MAX_RETRIES=10

# ---------------------------------------------------------------------------
# Kafka (KRaft, no ZooKeeper)
# ---------------------------------------------------------------------------
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=payhub
KAFKA_CONSUMER_GROUP=payhub-api
KAFKA_TOPIC_PREFIX=payhub
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=none
KAFKA_MAX_DELIVERY_ATTEMPTS=5
# 1 is the only value a single-broker machine can create. Raise it with the
# cluster: at 1 there is one in-sync replica, so `acks: all` means `acks: 1`
# and one lost disk destroys an event the outbox already marked published.
KAFKA_REPLICATION_FACTOR=1
# Defaults to KAFKA_REPLICATION_FACTOR - 1: a three-broker cluster keeps
# accepting writes with one broker down, and refuses a write only one
# replica holds.
# KAFKA_MIN_INSYNC_REPLICAS=2

# ---------------------------------------------------------------------------
# gRPC (api → ledger)
# ---------------------------------------------------------------------------
GRPC_LISTEN_URL=0.0.0.0:50051
LEDGER_GRPC_URL=localhost:50051
GRPC_DEADLINE_MS=3000

# ---------------------------------------------------------------------------
# Auth — generate real secrets with `openssl rand -base64 48`
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=dev-access-secret-change-me-at-least-32-chars
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-at-least-32-chars
JWT_REFRESH_TTL_SEC=2592000
JWT_ISSUER=payhub
JWT_AUDIENCE=payhub-api
API_KEY_PEPPER=dev-api-key-pepper-change-me
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# ---------------------------------------------------------------------------
# Rate limiting & idempotency
# ---------------------------------------------------------------------------
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
IDEMPOTENCY_TTL_SEC=86400
# Must outlive REQUEST_TIMEOUT_MS. The timeout interceptor stops waiting
# but does not cancel the handler, so the payment keeps committing after
# the client is told it failed; a lock that expires at the same instant
# lets the retry through to start a second one. The unique index on
# (user_id, idempotency_key) catches that, and should stay the backstop
# rather than the mechanism.
IDEMPOTENCY_LOCK_TTL_MS=45000
DISTRIBUTED_LOCK_TTL_MS=30000

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=200
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_CONCURRENCY=10
RECONCILIATION_CRON="*/5 * * * *"

# ---------------------------------------------------------------------------
# LLM assistant — set LLM_ENABLED=true and provide a key to switch it on
# ---------------------------------------------------------------------------
LLM_ENABLED=false
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_MAX_OUTPUT_TOKENS=1024
# Must stay below REQUEST_TIMEOUT_MS. The inner call has to fail first,
# or the HTTP layer abandons a request the provider keeps billing for —
# and the retry loop uses this as the budget for all attempts together.
LLM_REQUEST_TIMEOUT_MS=25000
LLM_USER_RPM=10
LLM_USER_DAILY_TOKEN_BUDGET=100000
LLM_CACHE_TTL_SEC=300
LLM_MAX_RETRIES=3
