{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "sourceMap": false,
    "incremental": false,
    "noUnusedLocals": false
  },
  "include": ["apps/**/*.ts", "libs/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "scripts",
    "**/*.spec.ts",
    "**/*.e2e-spec.ts",
    "**/__tests__/**"
  ]
}
